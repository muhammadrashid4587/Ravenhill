FROM python:3.13-slim

WORKDIR /app

# Copy the entire api package first so setuptools' find_packages discovers
# every module at install time. Trades some build-cache granularity for
# resilience when modules are added/renamed.
COPY packages/api/ .

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
