# LLM Provider: "auto" | "groq" | "gemini" | "anthropic" | "mock"
LLM_PROVIDER=auto

# Cerebras (free tier — sign up at cloud.cerebras.ai)
CEREBRAS_API_KEY=your-cerebras-key-here

# Claude API
ANTHROPIC_API_KEY=your-key-here

# Groq (free tier — sign up at console.groq.com)
GROQ_API_KEY=your-groq-key-here

# Gemini (free tier — sign up at aistudio.google.com)
GEMINI_API_KEY=your-gemini-key-here

# Database
DATABASE_URL=postgresql://eagent:eagent@localhost:5432/eagent

# Redis
REDIS_URL=redis://localhost:6379

# ETO
ETO_API_KEY=your-eto-key-here
ETO_API_URL=https://api.eto.markets/v1

# App
APP_ENV=development
API_PORT=8000
WEB_PORT=3000
