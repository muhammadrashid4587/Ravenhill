# LLM Provider: "auto" | "groq" | "gemini" | "anthropic" | "mock"
LLM_PROVIDER=auto

# Cerebras (free tier — sign up at cloud.cerebras.ai)
CEREBRAS_API_KEY=your-cerebras-key-here

# Claude API
ANTHROPIC_API_KEY=your-key-here

# Groq (free tier — sign up at console.groq.com)
GROQ_API_KEY=your-groq-key-here

# Gemini (free tier — sign up at aistudio.google.com)
GEMINI_API_KEY=your-gemini-key-here

# Database
DATABASE_URL=postgresql://eagent:eagent@localhost:5432/eagent

# Redis
REDIS_URL=redis://localhost:6379

# Singularity
SINGULARITY_API_KEY=your-singularity-key-here
SINGULARITY_API_URL=https://api.singularity.markets/v1

# App
APP_ENV=development
API_PORT=8000
WEB_PORT=3000

# Auth — admin-issued magic-link invites.
# ADMIN_TOKEN gates POST /api/auth/invite. Leave empty in prod you're
# not operating yet — the endpoint returns 404 until a value is set.
# Generate with:  openssl rand -hex 32
ADMIN_TOKEN=
# Where the frontend lives; used to build invite URLs and to mark the
# session cookie Secure in HTTPS deployments.
SITE_URL=http://localhost:3000
SESSION_COOKIE_NAME=ravenhill_session
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7

# Frontend — published env vars (NEXT_PUBLIC_* are shipped to the browser).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
